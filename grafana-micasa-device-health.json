              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 15,
                        "color": "#EAB839"
                      },
                      {
                        "value": 35,
                        "color": "green"
                      }
                    ]
                  },
                  "mappings": [],
                  "unit": "percent",
                  "noValue": "-"
                },
                "overrides": []
              }
            }
          }
        }
