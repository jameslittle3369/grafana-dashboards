      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Battery Trend",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH logs AS (\n    SELECT l.recorded_at AS time, d.name || '-Ikea' AS device, l.battery_pct::numeric AS battery_pct\n    FROM ikea_device_logs l\n    JOIN ikea_devices d ON d.id = l.device_id\n\n    UNION ALL\n\n    SELECT l.recorded_at AS time, d.name || '-Ring' AS device, l.battery_life::numeric AS battery_pct\n    FROM ring_device_logs l\n    JOIN ring_devices d ON d.id = l.device_id\n)\n-- Pivoted wide format (one named column per device) instead of a generic\n-- long-format \"metric\"/\"value\" pair split via a transformation -- matches\n-- how every other multi-series panel in these dashboards already works\n-- (Inside Temperatures, Energy Circuits, HVAC Zones, etc.), and sidesteps\n-- Grafana's field-display-name disambiguation entirely: each column's own\n-- alias IS the series name, so there's no shared/generic field name left\n-- for Grafana to need to disambiguate (that's what was producing the\n-- stray \"value\" text in earlier label-based attempts).\n--\n-- Only rows inside the selected time window are counted -- no backward or\n-- forward fill. Ring devices log roughly every 5 minutes while active, so\n-- a device that's reporting normally already has plenty of real in-window\n-- points for the sparkline; a device that hasn't logged at all in this\n-- window (dead battery, offline, removed) correctly gets an all-NULL\n-- column here, and \"lastNotNull\" + the panel's \"No value\" option then\n-- shows \"-\" for it instead of silently repeating a stale old reading as\n-- if it were current. Device list comes from battery_device_names.json --\n-- add a name there when hardware changes, same as HVAC zones/energy\n-- circuits elsewhere in this project already require a code change for.\nSELECT\n    date_trunc('minute', time) AS time,\n    MAX(battery_pct) FILTER (WHERE device = 'Back L-Ring') AS \"Back L-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Back Zebo-Ring') AS \"Back Zebo-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Back shed-Ring') AS \"Back shed-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Back walk-Ring') AS \"Back walk-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Back-Ring') AS \"Back-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Driveway-Ring') AS \"Driveway-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Dunno Where 1-Ring') AS \"Dunno Where 1-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Front L-Ring') AS \"Front L-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Front-Ring') AS \"Front-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Playground-Ring') AS \"Playground-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Sidewalk-Ring') AS \"Sidewalk-Ring\",\n    MAX(battery_pct) FILTER (WHERE device = 'Left-Ikea') AS \"Left-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Top Right-Ikea') AS \"Top Right-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Top Middle-Ikea') AS \"Top Middle-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Open/close remote living-Ikea') AS \"Open/close remote living-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Top Remote-Ikea') AS \"Top Remote-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Top Left-Ikea') AS \"Top Left-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'TRADFRI open/close remote-Ikea') AS \"TRADFRI open/close remote-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Right Bedroom Blind-Ikea') AS \"Right Bedroom Blind-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Middle-Ikea') AS \"Middle-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Left Bedroom Blind-Ikea') AS \"Left Bedroom Blind-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Right-Ikea') AS \"Right-Ikea\",\n    MAX(battery_pct) FILTER (WHERE device = 'Middle Bedroom Blind-Ikea') AS \"Middle Bedroom Blind-Ikea\"\nFROM logs\nWHERE $__timeFilter(time)\nGROUP BY date_trunc('minute', time)\nORDER BY time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
