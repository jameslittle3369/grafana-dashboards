        "spec": {
          "id": 1,
          "title": "Device Battery Percentage",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select name || '-Ikea' Device,battery_pct Percentage ,last_seen_at as last from ikea_devices\n\nUNION ALL\n\nselect name || '-Ring',battery_life as Percentage,last_motion_at as last from ring_devices\norder by Percentage",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.2.0",
            "spec": {
