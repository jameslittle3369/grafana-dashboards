{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "namespace": "default"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "HVAC Zone Temperatures",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    date_trunc('minute', l.recorded_at) AS time,\n    MAX(l.disp_temperature) FILTER (WHERE z.name = 'Downstairs') AS \"Downstairs Temp\",\n    MAX(l.heat_setpoint)    FILTER (WHERE z.name = 'Downstairs') AS \"Downstairs Heat SP\",\n    MAX(l.cool_setpoint)    FILTER (WHERE z.name = 'Downstairs') AS \"Downstairs Cool SP\",\n    MAX(l.disp_temperature) FILTER (WHERE z.name = 'Upstairs')   AS \"Upstairs Temp\",\n    MAX(l.heat_setpoint)    FILTER (WHERE z.name = 'Upstairs')   AS \"Upstairs Heat SP\",\n    MAX(l.cool_setpoint)    FILTER (WHERE z.name = 'Upstairs')   AS \"Upstairs Cool SP\"\nFROM hvac_zone_logs l\nJOIN hvac_zones z ON z.external_id = l.hvac_zone_id\nWHERE l.recorded_at BETWEEN CAST($__timeFrom() AS timestamptz) AND CAST($__timeTo() AS timestamptz)\nGROUP BY time\nORDER BY time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "min",
                    "max",
                    "mean"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "percentage",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 40,
                        "color": "#EAB839"
                      },
                      {
                        "value": 60,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic",
                    "seriesBy": "last"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 7,
                    "gradientMode": "opacity",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "smooth",
                    "lineStyle": {
                      "fill": "solid"
                    },
                    "lineWidth": 1,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": true,
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "fieldMinMax": false
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "HVAC Stats",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "-- Dashboard --"
                      },
                      "spec": {
                        "panelId": 1
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max",
                    "mean"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "percentChangeColorMode": "standard",
                "showPercentChange": false,
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      }
                    ]
                  },
                  "mappings": []
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "HVAC Zones \u2014 Latest Reading",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH range_stats AS (\n    SELECT hvac_zone_id, MAX(disp_temperature) AS high_temp, MIN(disp_temperature) AS low_temp\n    FROM hvac_zone_logs\n    WHERE $__timeFilter(recorded_at)\n    GROUP BY hvac_zone_id\n)\nSELECT DISTINCT ON (z.name)\n    z.name AS \"Zone\",\n    l.disp_temperature AS \"Temp (\u00b0F)\",\n    r.high_temp AS \"High Temp (\u00b0F)\",\n    r.low_temp AS \"Low Temp (\u00b0F)\",\n    l.heat_setpoint AS \"Heat SP\",\n    l.cool_setpoint AS \"Cool SP\",\n    l.indoor_humidity AS \"Indoor Humidity %\",\n    l.outdoor_temperature AS \"Outdoor Temp (\u00b0F)\",\n    l.system_switch_position AS \"Mode\",\n    l.fan_mode AS \"Fan Mode\",\n    l.equipment_output_status AS \"Equipment Status\",\n    l.recorded_at AS \"Last Reading\"\nFROM hvac_zone_logs l\nJOIN hvac_zones z ON z.external_id = l.hvac_zone_id\nLEFT JOIN range_stats r ON r.hvac_zone_id = z.external_id\nORDER BY z.name, l.recorded_at DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "footer": {
                  "countRows": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                },
                "showHeader": true,
                "showTypeIcons": false
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  },
                  "mappings": []
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
