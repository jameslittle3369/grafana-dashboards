      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Air Quality \u2014 Latest Reading",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\n    SELECT DISTINCT ON (measurement) measurement, value, created_at\n    FROM aqsensors_aqlog\n    ORDER BY measurement, created_at DESC\n),\nrange_stats AS (\n    SELECT measurement, MAX(value) AS high, MIN(value) AS low\n    FROM aqsensors_aqlog\n    WHERE $__timeFilter(created_at)\n    GROUP BY measurement\n)\nSELECT\n    l.measurement AS \"Measurement\",\n    l.value AS \"Value\",\n    r.high AS \"High\",\n    r.low AS \"Low\",\n    l.created_at AS \"Last Reading\"\nFROM latest l\nLEFT JOIN range_stats r ON r.measurement = l.measurement\nORDER BY l.measurement;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
