      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Inside Temperatures",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH combined AS (\n    SELECT b.created_at AS time, a.pretty_name, (b.primary_value * 9/5) + 32 AS temp_f\n    FROM tstats_thermometer a\n    JOIN tstats_tstatlog b ON a.romid = b.romid_id\n\n    UNION ALL\n\n    SELECT b.created_at AS time, a.pretty_name, b.temp_f\n    FROM tstats_thermohygrometer a\n    JOIN tstats_thermohygrostatlog b ON b.thermohygrometer_id = a.id_channel\n),\nin_window AS (\n    SELECT time, pretty_name, temp_f FROM combined WHERE $__timeFilter(time)\n),\n-- Carries each device's value backward to the start of the visible\n-- window (its most recent reading at/before the window start), so the\n-- line doesn't start from nothing if the last real change predates\n-- this window. Bounded to the last 48 hours before the window start --\n-- without a bound this has to scan/sort the *entire* historical table\n-- per device (years of legacy data), which is what was timing out.\n-- ORDER BY qualifies combined.time explicitly -- without that, Postgres\n-- resolves the bare \"time\" to this SELECT's own output alias (a\n-- constant) instead of the real per-row timestamp, silently breaking\n-- \"most recent\" into an arbitrary row.\nbackfilled_start AS (\n    SELECT DISTINCT ON (pretty_name) $__timeFrom()::timestamptz AS time, pretty_name, temp_f\n    FROM combined\n    WHERE time BETWEEN $__timeFrom()::timestamptz - interval '48 hours' AND $__timeFrom()::timestamptz\n    ORDER BY pretty_name, combined.time DESC\n),\n-- Carries each device's value forward to now -- dedup (thermohygrometers)\n-- means nothing gets logged again until the value actually changes.\n-- Same bounded-lookback and combined.time qualification reasons as above.\nforward_filled_now AS (\n    SELECT DISTINCT ON (pretty_name) now()::timestamptz AS time, pretty_name, temp_f\n    FROM combined\n    WHERE time BETWEEN now() - interval '48 hours' AND now()\n    ORDER BY pretty_name, combined.time DESC\n),\nall_rows AS (\n    SELECT * FROM in_window\n    UNION ALL SELECT * FROM backfilled_start\n    UNION ALL SELECT * FROM forward_filled_now\n)\nSELECT\n    date_trunc('minute', time) AS time,\n    MAX(CASE WHEN pretty_name = 'Master Bedroom' THEN temp_f END) AS \"Master Bedroom\",\n    MAX(CASE WHEN pretty_name = 'Gdn Clone' THEN temp_f END) AS \"Gdn Clone\",\n    MAX(CASE WHEN pretty_name = 'Out SEbS 142\u00b0' THEN temp_f END) AS \"Out SEbS 142\u00b0\",\n    MAX(CASE WHEN pretty_name = 'Gdn Near Res.' THEN temp_f END) AS \"Gdn Near Res.\",\n    MAX(CASE WHEN pretty_name = 'Garage' THEN temp_f END) AS \"Garage\",\n    MAX(CASE WHEN pretty_name = 'Main Attic' THEN temp_f END) AS \"Main Attic\",\n    MAX(CASE WHEN pretty_name = 'Garage Attic' THEN temp_f END) AS \"Garage Attic\",\n    MAX(CASE WHEN pretty_name = 'Jessica''s' THEN temp_f END) AS \"Jessica's\",\n    MAX(CASE WHEN pretty_name = 'Gdn Veg' THEN temp_f END) AS \"Gdn Veg\",\n    MAX(CASE WHEN pretty_name = 'Gdn Flower' THEN temp_f END) AS \"Gdn Flower\",\n    MAX(CASE WHEN pretty_name = 'Kitchen' THEN temp_f END) AS \"Kitchen\",\n    MAX(CASE WHEN pretty_name = 'Gdn Vent' THEN temp_f END) AS \"Gdn Vent\",\n    MAX(CASE WHEN pretty_name = 'Clone' THEN temp_f END) AS \"Clone\",\n    MAX(CASE WHEN pretty_name = 'Veg' THEN temp_f END) AS \"Veg\",\n    MAX(CASE WHEN pretty_name = 'Flower' THEN temp_f END) AS \"Flower\",\n    MAX(CASE WHEN pretty_name = 'Office' THEN temp_f END) AS \"Office\",\n    MAX(CASE WHEN pretty_name = 'Outside Station' THEN temp_f END) AS \"Outside Station\",\n    MAX(CASE WHEN pretty_name = 'Laundry Room' THEN temp_f END) AS \"Laundry Room\",\n    MAX(CASE WHEN pretty_name = 'Acurite-Tower 5715' THEN temp_f END) AS \"Acurite-Tower 5715\",\n    MAX(CASE WHEN pretty_name = 'Acurite-Tower 10196' THEN temp_f END) AS \"Acurite-Tower 10196\"\nFROM all_rows\nGROUP BY date_trunc('minute', time)\nORDER BY time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "filterFieldsByName",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "time",
                          "Master Bedroom",
                          "Kitchen",
                          "Office",
                          "Laundry Room",
                          "Jessica's"
                        ]
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "min",
                    "max",
                    "mean"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "percentage",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 40,
                        "color": "#EAB839"
                      },
                      {
                        "value": 60,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic",
                    "seriesBy": "last"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 7,
                    "gradientMode": "opacity",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "smooth",
                    "lineStyle": {
                      "fill": "solid"
                    },
                    "lineWidth": 1,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": true,
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "fieldMinMax": false
                },
                "overrides": []
              }
            }
          }
        }
