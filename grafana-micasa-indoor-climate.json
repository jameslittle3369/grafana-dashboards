      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Living Room Air Quality",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    date_trunc('minute', created_at) AS time, -- Groups into 1-minute blocks\n    MAX(value) FILTER (WHERE measurement = 'NO2')      AS no2,\n    MAX(value) FILTER (WHERE measurement = 'P10R')     AS p10r,\n    MAX(value) FILTER (WHERE measurement = 'P25R')     AS p25r,\n    MAX(value) FILTER (WHERE measurement = 'PM10')     AS pm10,\n    MAX(value) FILTER (WHERE measurement = 'PM25')     AS pm25,\n    MAX(value) FILTER (WHERE measurement = 'VOC')      AS voc\nFROM aqsensors_aqlog\nWHERE $__timeFilter(created_at)\nGROUP BY time  -- PostgreSQL natively allows grouping by SELECT aliases if no math is applied\nORDER BY time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
