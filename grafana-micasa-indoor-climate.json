      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Indoor Zones \u2014 Latest Reading",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH combined AS (\n    SELECT b.created_at AS time, a.pretty_name, (b.primary_value * 9/5) + 32 AS temp_f\n    FROM tstats_thermometer a JOIN tstats_tstatlog b ON a.romid = b.romid_id\n    UNION ALL\n    SELECT b.created_at AS time, a.pretty_name, b.temp_f\n    FROM tstats_thermohygrometer a JOIN tstats_thermohygrostatlog b ON b.thermohygrometer_id = a.id_channel\n),\nlatest AS (\n    SELECT DISTINCT ON (pretty_name) pretty_name, temp_f, time\n    FROM combined\n    WHERE pretty_name IN ('Master Bedroom', 'Kitchen', 'Office', 'Laundry Room', 'Jessica''s')\n    ORDER BY pretty_name, time DESC\n),\nrange_stats AS (\n    SELECT pretty_name, MAX(temp_f) AS high, MIN(temp_f) AS low\n    FROM combined\n    WHERE pretty_name IN ('Master Bedroom', 'Kitchen', 'Office', 'Laundry Room', 'Jessica''s') AND $__timeFilter(time)\n    GROUP BY pretty_name\n)\nSELECT\n    l.pretty_name AS \"Zone\",\n    l.temp_f AS \"Temp (\u00b0F)\",\n    r.high AS \"High (\u00b0F)\",\n    r.low AS \"Low (\u00b0F)\",\n    l.time AS \"Last Reading\"\nFROM latest l\nLEFT JOIN range_stats r ON r.pretty_name = l.pretty_name\nORDER BY l.pretty_name;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
