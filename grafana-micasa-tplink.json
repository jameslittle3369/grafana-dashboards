  "kind": "Dashboard",
  "metadata": {
    "namespace": "default"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "TP-Link Circuits",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    date_trunc('minute', l.recorded_at) AS time,\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916')                                        AS \"Strip 0916\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc PC')                                AS \"Ofc PC\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc Right Plug 1 Empty')                AS \"Ofc Right Plug 1 Empty\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc Alexa')                             AS \"Ofc Alexa\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc Honeywell-Acurite-Ikea')            AS \"Ofc Honeywell-Acurite-Ikea\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc Netgear POE Switch')                AS \"Ofc Netgear POE Switch\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_0916 / Ofc Netgear RAX80 Router')              AS \"Ofc Netgear RAX80 Router\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA')                                         AS \"Strip 47EA\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Flower Fan')                     AS \"Garden Flower Fan\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Flower Feed')                    AS \"Garden Flower Feed\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Flower Lights')                  AS \"Garden Flower Lights\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Propagation Heater')             AS \"Garden Propagation Heater\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Veg Feed')                       AS \"Garden Veg Feed\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_47EA / Garden Veg Lights')                     AS \"Garden Veg Lights\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1')                                         AS \"Strip EEF1\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc Desk Light')                        AS \"Ofc Desk Light\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc Left 3 Empty')                      AS \"Ofc Left 3 Empty\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc PC Monitor')                        AS \"Ofc PC Monitor\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc PC Speakers')                       AS \"Ofc PC Speakers\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc Printer')                           AS \"Ofc Printer\",\n    MAX(l.watts) FILTER (WHERE c.name = 'TP-LINK_Power Strip_EEF1 / Ofc Uplift Desk')                       AS \"Ofc Uplift Desk\"\nFROM energy_circuit_logs l\nJOIN energy_circuits c ON c.id = l.circuit_id\nWHERE l.recorded_at BETWEEN CAST($__timeFrom() AS timestamptz) AND CAST($__timeTo() AS timestamptz)\n  AND c.name LIKE 'TP-LINK_Power Strip%'\nGROUP BY time\nORDER BY time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "min",
                    "max",
                    "mean"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "percentage",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 40,
                        "color": "#EAB839"
                      },
                      {
                        "value": 60,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic",
                    "seriesBy": "last"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 7,
                    "gradientMode": "opacity",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "smooth",
                    "lineStyle": {
                      "fill": "solid"
                    },
                    "lineWidth": 1,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": true,
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "fieldMinMax": false
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "TP-Link Stats",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "-- Dashboard --"
                      },
                      "spec": {
                        "panelId": 1
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.0",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull",
                    "min",
                    "max",
                    "mean"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "percentChangeColorMode": "standard",
                "showPercentChange": false,
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      }
                    ]
                  },
                  "mappings": []
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "TP-Link Plugs \u2014 Latest Reading",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvq4sip0ynlsf"
                      },
                      "spec": {
                        "dataset": "api",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH range_stats AS (\n    SELECT circuit_id, MAX(watts) AS high, MIN(watts) AS low\n    FROM energy_circuit_logs\n    WHERE $__timeFilter(recorded_at)\n    GROUP BY circuit_id\n)\nSELECT\n    c.name AS \"Plug/Strip\",\n    c.current_watts AS \"Current (W)\",\n    r.high AS \"High (W)\",\n    r.low AS \"Low (W)\",\n    c.kwh_today AS \"kWh Today\",\n    c.kwh_7d AS \"kWh 7d\",\n    c.kwh_30d AS \"kWh 30d\",\n    c.kwh_mtd AS \"kWh MTD\"\nFROM energy_circuits c\nLEFT JOIN range_stats r ON r.circuit_id = c.id\nWHERE c.name LIKE 'TP-LINK_Power Strip%'\nORDER BY c.name;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "api"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "footer": {
                  "countRows": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                },
                "showHeader": true,
                "showTypeIcons": false
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  },
                  "mappings": []
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
